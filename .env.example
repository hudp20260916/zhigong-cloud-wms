# ===== 后端（server） =====
# 服务监听端口
PORT=3001
# SQLite 数据文件路径（容器/云主机部署时挂载到持久卷）
DB_FILE=./data/app.db
# JWT 签名密钥：生产环境必须改成长随机串（如 openssl rand -hex 32 生成）
JWT_SECRET=change-me-to-a-long-random-secret
# 一体化部署时如需托管前端，把 web/dist 构建出来即可，无需配置

# ===== 前端（web，构建时注入） =====
# 前后端分离部署时填写后端完整地址，例如 https://your-api.onrender.com
# 同域部署（Nginx 反代 / 后端托管前端）留空即可
# VITE_API_BASE=https://your-api.example.com
